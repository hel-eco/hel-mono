{
  "name": "hub-ex",
  "version": "0.0.4",
  "hel": {
    "ciCmd": "build:hel",
    "isEX": true
  },
  "main": "./src/index",
  "scripts": {
    "start": "node ../../dev/root-scripts/executeStart",
    "start:raw": "node ../../dev/scripts/start",
    "start:hel": "node ../../dev/scripts/hel/start.js",
    "build": "node ../../dev/scripts/build.js",
    "build:hel": "node ../../dev/scripts/hel/build.js",
    "build:helm": "cross-env-shell \"pnpm run build:hel && pnpm run build:meta\"",
    "build:meta": "node ../../dev/scripts/hel/meta"
  },
  "dependencies": {
    "@helux/store-pinia": "^5.0.3",
    "helux": "^5.5.3",
    "helux-mini": "^1.2.7",
    "limu": "^4.1.1",
    "lodash": "^4.17.21",
    "mobx": "^6.15.0",
    "papaparse": "^5.5.3",
    "ppo": "^1.5.2",
    "qrcodejs": "^1.0.0",
    "recharts": "^3.5.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "volta": {
    "node": "20.19.5",
    "pnpm": "8.6.8"
  },
  "files": [
    "!src",
    "hel_dist"
  ]
}